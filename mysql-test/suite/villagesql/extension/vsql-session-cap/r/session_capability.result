SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_session_cap_test;
# login_user matches CURRENT_USER's user part
SELECT vsql_session_cap_test.login_user() =
SUBSTRING_INDEX(CURRENT_USER(), '@', 1) AS login_user_matches;
login_user_matches
1
# query_text reflects the running statement (contains the function name)
SELECT vsql_session_cap_test.query_text() LIKE '%query_text%' AS query_text_ok;
query_text_ok
1
# host_or_ip is non-empty for a connected session
SELECT LENGTH(vsql_session_cap_test.host_or_ip()) > 0 AS host_or_ip_present;
host_or_ip_present
1
# active_roles is NONE when no role is active
SELECT vsql_session_cap_test.active_roles() AS active_roles;
active_roles
NONE
# da_status returns an integer bitmask (non-null)
SELECT vsql_session_cap_test.da_status() IS NOT NULL AS da_status_present;
da_status_present
1
UNINSTALL EXTENSION vsql_session_cap_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
